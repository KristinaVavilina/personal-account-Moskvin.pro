# Скопируйте в .env.local для локальной разработки:  cp env.example .env.local
#
# Production (Docker / vite build): переменные не обязательны.
# API вызывается по относительному пути /api/* — nginx проксирует на backend.

# --- только разработка ---

# Подмена текущего пользователя без полноценного входа (UUID из БД).
# VITE_DEV_USER_ID=a1000000-0000-4000-8000-000000000001

# Куда Vite проксирует /api (по умолчанию http://localhost:8080)
# VITE_API_PROXY_TARGET=http://localhost:8080
